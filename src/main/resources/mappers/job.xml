<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.shinhan.bananaapp.mapper.JobMapper">
    <!-- ResultMap: DB 컬럼 → Java 필드 명시적 매핑 -->
    <resultMap id="jobResultMap" type="JobDTO">
        <id property="jobId" column="job_id"/>
        <result property="jobTitle" column="job_title"/>
        <result property="minSalary" column="min_salary"/>
        <result property="maxSalary" column="max_salary"/>
    </resultMap>
    <select id="findAll" resultMap="jobResultMap">
        SELECT *
        FROM jobs
        ORDER BY job_id DESC
    </select>
</mapper>